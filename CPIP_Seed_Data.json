"""
CPIP Seed Data — SINGLE SOURCE OF TRUTH

CHANGED (big one): no more loading a seed JSON file at all. Every store
(students, jobs, resumes, notifications) starts genuinely empty and is
populated only by REAL actions — a real resume upload, a real job
posting. The old file also carried a static "skills" vocabulary; that's
gone too, replaced by get_or_fetch_market_skills(), which pulls the
REAL skills the job market demands for a specific role (via JSearch),
not a fixed hand-picked list. CPIP_Seed_Data.json is no longer read by
any code — safe to delete.
"""

from datetime import datetime
import time

_STUDENTS_BY_ID = {}
_NEXT_STUDENT_ID = 1


def get_student(student_id):
    return _STUDENTS_BY_ID.get(student_id)


def get_all_students():
    return list(_STUDENTS_BY_ID.values())


def add_student(student_data):
    global _NEXT_STUDENT_ID
    new_student = {
        "id": _NEXT_STUDENT_ID,
        "name": student_data.get("name", "Candidate"),
        "email": student_data.get("email", ""),
        "degree": student_data.get("degree", "Not specified"),
        "cgpa": student_data.get("cgpa", 0),
        "location": student_data.get("location", "Not specified"),
        "target_role": student_data.get("target_role", ""),
        "github_link": student_data.get("github_link", ""),
        "linkedin_id": student_data.get("linkedin_id", ""),
        "resume": student_data.get("resume", ""),
        "salary_expected": student_data.get("salary_expected", 0),
        "skills": student_data.get("skills", []),
    }
    _STUDENTS_BY_ID[_NEXT_STUDENT_ID] = new_student
    _NEXT_STUDENT_ID += 1
    return new_student


