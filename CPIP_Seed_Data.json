_JOBS = []
_NEXT_JOB_ID = 1


def get_all_jobs():
    return _JOBS


def get_job(job_id):
    return next((j for j in _JOBS if j["id"] == job_id), None)


def search_jobs(jobs, query):
    if not query or not query.strip():
        return jobs

    q = query.strip().lower()
    results = []
    for job in jobs:
        haystack = " ".join([
            job.get("job_title", ""),
            job.get("company_name", ""),
            job.get("location", ""),
            " ".join(job.get("required_skills", [])),
            " ".join(job.get("preferred_skills", [])),
        ]).lower()
        if q in haystack:
            results.append(job)
    return results


def add_job(job_data):
    global _NEXT_JOB_ID
    new_job = {
        "id": _NEXT_JOB_ID,
        "job_title": job_data["job_title"],
        "company_name": job_data.get("company_name", "Unknown"),
        "location": job_data.get("location", "Remote"),
        "required_skills": job_data.get("required_skills", []),
        "preferred_skills": job_data.get("preferred_skills", []),
        "min_cgpa": job_data.get("min_cgpa", 0),
        "min_readiness": job_data.get("min_readiness", 0),
        "experience_level": job_data.get("experience_level") or "Not specified",
        "posted_date": datetime.now().strftime("%b %d, %Y"),
    }
    _JOBS.append(new_job)
    _NEXT_JOB_ID += 1
    return new_job


_RESUMES_BY_STUDENT = {}


def get_resume(student_id):
    return _RESUMES_BY_STUDENT.get(student_id)


def add_resume(student_id, resume_data):
    _RESUMES_BY_STUDENT[student_id] = resume_data
    return resume_data


_NOTIFICATIONS = []
_NEXT_NOTIFICATION_ID = 1


def add_notification(student_id, job_id, job_title, company_name, fit_score, suitability):
    global _NEXT_NOTIFICATION_ID
    notification = {
        "id": _NEXT_NOTIFICATION_ID,
        "student_id": student_id,
        "job_id": job_id,
        "job_title": job_title,
        "company_name": company_name,
        "fit_score": fit_score,
        "suitability": suitability,
        "created_at": datetime.now().strftime("%b %d, %Y %H:%M"),
        "read": False,
    }
    _NOTIFICATIONS.append(notification)
    _NEXT_NOTIFICATION_ID += 1
    return notification


def get_notifications_for_student(student_id):
    return sorted(
        [n for n in _NOTIFICATIONS if n["student_id"] == student_id],
        key=lambda n: n["id"],
        reverse=True,
    )


def mark_notification_read(notification_id):
    for n in _NOTIFICATIONS:
        if n["id"] == notification_id:
            n["read"] = True
            return n
    return None


_MARKET_SKILL_CACHE = {}
_MARKET_CACHE_TTL_SECONDS = 24 * 60 * 60


def get_cached_market_skill_demand(target_role):
    key = target_role.strip().lower()
    entry = _MARKET_SKILL_CACHE.get(key)
    if entry is None:
        return None
    if time.time() - entry["cached_at"] > _MARKET_CACHE_TTL_SECONDS:
        return None
    return entry


def cache_market_skill_demand(target_role, skill_frequency, total_postings):
    key = target_role.strip().lower()
    entry = {
        "skill_frequency": skill_frequency,
        "total_postings": total_postings,
        "cached_at": time.time(),
    }
    _MARKET_SKILL_CACHE[key] = entry
    return entry


def get_or_fetch_market_skills(target_role):
    from app.services.external_jobs_service import fetch_market_skill_frequency

    cached = get_cached_market_skill_demand(target_role)
    if cached is None:
        skill_frequency, total_postings = fetch_market_skill_frequency(target_role)
        cached = cache_market_skill_demand(target_role, skill_frequency, total_postings)
    return cached["skill_frequency"]